Implementa detección AABB:

```ts
export function intersectsAABB(
  a: CollisionBox,
  b: CollisionBox
): boolean {
  return (
    a.x < b.x + b.width &&
    a.x + a.width > b.x &&
    a.y < b.y + b.height &&
    a.y + a.height > b.y
  );
}
```

